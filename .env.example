# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Set environment: QA, UAT, or STAGING
# This is set by Jenkins parameter - local default is not set
ENVIRONMENT=

# ============================================
# ENVIRONMENT-SPECIFIC URLs
# ============================================
# QA Environment URL (PLACEHOLDER - Replace with actual QA URL)
QA_BASE_URL=https://qa.theaa.com

# UAT Environment URL (PLACEHOLDER - Replace with actual UAT URL)
UAT_BASE_URL=https://uat.theaa.com

# STAGING Environment URL (PLACEHOLDER - Replace with actual STAGING URL)
STAGING_BASE_URL=https://staging.theaa.com

# Default/Production Base URL
BASE_URL=https://www.theaa.com

# ============================================
# TEST USER CREDENTIALS
# ============================================
# Test user credentials (use Jenkins credentials for sensitive data)
TEST_USERNAME=testuser@example.com
TEST_PASSWORD=Test@1234

# Admin user credentials (use Jenkins credentials for sensitive data)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=Admin@1234

# ============================================
# BROWSER SETTINGS
# ============================================
# Run in headless mode (true/false)
HEADLESS=false

# Slow motion delay in milliseconds (0 = no delay)
SLOW_MO=0

# ============================================
# TIMEOUTS (milliseconds)
# ============================================
# Default test timeout (30 seconds)
DEFAULT_TIMEOUT=30000

# Navigation timeout (15 seconds)
NAVIGATION_TIMEOUT=15000

# Action timeout (10 seconds)
ACTION_TIMEOUT=10000

# ============================================
# SCREENSHOTS AND VIDEOS
# ============================================
# Take screenshot on failure (true/false)
SCREENSHOT_ON_FAILURE=true

# Record video on failure (true/false)
VIDEO_ON_FAILURE=true

# ============================================
# TEST EXECUTION
# ============================================
# Number of parallel workers
WORKERS=4

# Number of retries on failure
RETRIES=2

# ============================================
# CI/CD SETTINGS
# ============================================
# CI flag (set to true in Jenkins)
CI=false
