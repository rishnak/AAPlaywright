/**
 * Jenkins Pipeline for Playwright Test Automation Framework
 * Supports multiple environments and browsers
 */

pipeline {
    agent any
    
    // Environment variables
    environment {
        // Node.js version
        NODE_VERSION = '18'
        
        // Base URL - can be overridden by Jenkins parameters
        BASE_URL = "${params.BASE_URL ?: 'https://www.theaa.com'}"
        
        // Test execution settings
        HEADLESS = 'true'
        CI = 'true'
        
        // Report directories
        REPORT_DIR = 'playwright-report'
        TEST_RESULTS_DIR = 'test-results'
    }
    
    // Pipeline parameters
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'production'],
            description: 'Select environment to test'
        )
        choice(
            name: 'BROWSER',
            choices: ['all', 'chromium', 'firefox', 'webkit'],
            description: 'Select browser to run tests'
        )
        choice(
            name: 'TEST_SUITE',
            choices: ['all', 'login', 'home', 'smoke'],
            description: 'Select test suite to run'
        )
        string(
            name: 'BASE_URL',
            defaultValue: 'https://www.theaa.com',
            description: 'Base URL for testing'
        )
        booleanParam(
            name: 'GENERATE_REPORT',
            defaultValue: true,
            description: 'Generate HTML report'
        )
    }
    
    // Pipeline stages
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code from repository...'
                checkout scm
            }
        }
        
        stage('Setup Node.js') {
            steps {
                echo "Setting up Node.js ${NODE_VERSION}..."
                // Using NodeJS plugin
                nodejs(nodeJSInstallationName: "Node ${NODE_VERSION}") {
                    sh 'node --version'
                    sh 'npm --version'
                }
            }
        }
        
        stage('Install Dependencies') {
            steps {
                echo 'Installing npm dependencies...'
                nodejs(nodeJSInstallationName: "Node ${NODE_VERSION}") {
                    sh 'npm ci'
                }
            }
        }
        
        stage('Install Playwright Browsers') {
            steps {
                echo 'Installing Playwright browsers...'
                nodejs(nodeJSInstallationName: "Node ${NODE_VERSION}") {
                    sh 'npx playwright install --with-deps chromium firefox webkit'
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                script {
                    echo "Running ${params.TEST_SUITE} tests on ${params.BROWSER} browser(s)..."
                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Base URL: ${BASE_URL}"
                    
                    nodejs(nodeJSInstallationName: "Node ${NODE_VERSION}") {
                        // Build test command based on parameters
                        def testCommand = 'npx playwright test'
                        
                        // Add browser filter
                        if (params.BROWSER != 'all') {
                            testCommand += " --project=${params.BROWSER}"
                        }
                        
                        // Add test suite filter
                        if (params.TEST_SUITE == 'login') {
                            testCommand += ' tests/login.spec.ts'
                        } else if (params.TEST_SUITE == 'home') {
                            testCommand += ' tests/home.spec.ts'
                        } else if (params.TEST_SUITE == 'smoke') {
                            testCommand += ' --grep @smoke'
                        }
                        
                        // Execute tests
                        sh """
                            export BASE_URL=${BASE_URL}
                            export CI=true
                            export HEADLESS=true
                            ${testCommand}
                        """
                    }
                }
            }
        }
        
        stage('Generate Report') {
            when {
                expression { params.GENERATE_REPORT == true }
            }
            steps {
                echo 'Generating test report...'
                // Report is automatically generated by Playwright
                echo 'HTML report available in playwright-report directory'
            }
        }
    }
    
    // Post-build actions
    post {
        always {
            echo 'Archiving test results and reports...'
            
            // Archive test results
            archiveArtifacts artifacts: 'test-results/**/*', allowEmptyArchive: true
            archiveArtifacts artifacts: 'playwright-report/**/*', allowEmptyArchive: true
            archiveArtifacts artifacts: 'screenshots/**/*', allowEmptyArchive: true
            
            // Publish HTML report
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'playwright-report',
                reportFiles: 'index.html',
                reportName: 'Playwright Test Report',
                reportTitles: 'Playwright Test Results'
            ])
            
            // Publish JUnit test results
            junit testResults: 'test-results/junit.xml', allowEmptyResults: true
            
            // Clean up workspace
            cleanWs(
                deleteDirs: true,
                patterns: [
                    [pattern: 'node_modules', type: 'INCLUDE'],
                    [pattern: '.playwright', type: 'INCLUDE']
                ]
            )
        }
        
        success {
            echo 'Pipeline executed successfully!'
            // Send success notification (configure as needed)
            // emailext subject: 'Test Passed', body: 'All tests passed', to: 'team@example.com'
        }
        
        failure {
            echo 'Pipeline failed!'
            // Send failure notification (configure as needed)
            // emailext subject: 'Test Failed', body: 'Tests failed', to: 'team@example.com'
        }
    }
}